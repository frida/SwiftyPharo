"
A bar chart whose bars stand up, standing in for GtPlotterVerticalBarChart. Its
value is the bars' height, and runs up the frame.
"
Class {
	#name : 'SwpVerticalBarChart',
	#superclass : 'SwpBarChart',
	#category : 'SwiftyPharo',
	#package : 'SwiftyPharo'
}

{ #category : 'accessing' }
SwpVerticalBarChart >> orientation [
	^ 'vertical'
]
