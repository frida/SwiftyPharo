"
A bar chart whose bars stand up, standing in for GtPlotterVerticalBarChart. Its
value is the bars' height rather than their width.
"
Class {
	#name : 'SwpChartVertical',
	#superclass : 'SwpChart',
	#category : 'SwiftyPharo',
	#package : 'SwiftyPharo'
}

{ #category : 'accessing' }
SwpChartVertical >> orientation [
	^ 'vertical'
]
